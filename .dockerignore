# Secrets and local config: never bake into the image
.env
.env.*
!.env.example

# Installed on the host / inside the container, not copied into the image
vendor
node_modules

# Noise
.git
.github
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
tests
coverage
*.log
